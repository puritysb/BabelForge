# book_translator local secrets — DO NOT COMMIT.
# Loaded by config.py via _load_dotenv(); real environment variables win.
GLM_API_KEY=

# Require the official full EPUB validator for publication (Java required).
# Install once: ./venv/bin/python3 scripts/setup_epubcheck.py
# BABELFORGE_REQUIRE_EPUBCHECK=1
# EPUBCHECK_JAR=

# Optional custom LaunchAgent for managed read-only Calibre maintenance.
# Its library and port must match; publication never changes its access policy.
# BABELFORGE_CALIBRE_LAUNCH_AGENT=~/Library/LaunchAgents/com.local.calibre-server.plist

# Preserve original paragraphs. Optional sentence units within those paragraphs:
# BABELFORGE_SENTENCE_SPLIT=1

# Optional legacy device delivery; standard EPUB generation does not need this.
# BABELFORGE_DEVICE_PUSH=1

# Xteink X3 device host — leave unset to use AUTO-DISCOVERY (mDNS service
# browse + subnet scan with CrossPoint fingerprinting). Set explicitly only
# to override when auto-discovery is unsuitable (e.g. multi-device network).
# OPENCLAW_XTEINK_HOST=
